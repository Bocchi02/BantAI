BANTAI_DATABASE_URL=mysql+pymysql://bantai:change-me@127.0.0.1:3306/bantai
BANTAI_WEB_ORIGIN=http://localhost:3000
BANTAI_EXTENSION_ORIGIN=chrome-extension://replace-after-install
BANTAI_COOKIE_SECURE=false
BANTAI_CREATE_SCHEMA=true
BANTAI_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
BANTAI_ADMIN_EMAIL=admin@example.test
BANTAI_ADMIN_PASSWORD=replace-with-a-long-random-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BANTAI_LLM_TIMEOUT_SECONDS=12
