BANTAI_DATABASE_URL=mysql+pymysql://bantai_runtime:change-me@mysql:3306/bantai
BANTAI_DETECTOR_URL=http://detector:8000
BANTAI_INTERNAL_API_KEY=replace-with-at-least-32-random-characters
BANTAI_REMOTE_RUNTIME_REQUIRED=true
# Turn on public registration after configuring Gmail SMTP.
BANTAI_PUBLIC_REGISTRATION_ENABLED=false
# Use a Google App Password, never the normal account password.
BANTAI_GMAIL_SMTP_EMAIL=
BANTAI_GMAIL_SMTP_APP_PASSWORD=
BANTAI_WEB_ORIGIN=https://app.example.invalid
BANTAI_EXTENSION_ORIGIN=chrome-extension://replace-after-install
BANTAI_COOKIE_SECURE=true
BANTAI_CREATE_SCHEMA=false
BANTAI_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
BANTAI_ADMIN_EMAIL=admin@example.test
BANTAI_ADMIN_PASSWORD=replace-with-a-long-random-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_URL_MODEL=gemini-3.5-flash-lite
BANTAI_LLM_TIMEOUT_SECONDS=12
BANTAI_DETECTOR_READINESS_TIMEOUT_SECONDS=5
BANTAI_DETECTOR_INFERENCE_TIMEOUT_SECONDS=45
BANTAI_MAX_REQUEST_BYTES=262144
BANTAI_DETECTION_RATE_LIMIT_PER_5_MINUTES=120
BANTAI_TRUSTED_PROXY_CIDRS=replace-with-the-private-Caddy-source-CIDR-or-address
BANTAI_TRANSIENT_CONTEXT_TTL_SECONDS=600
BANTAI_TRANSIENT_CONTEXT_MAX_ENTRIES=512
