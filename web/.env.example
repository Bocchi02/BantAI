# Browser requests stay same-origin so the session and CSRF cookies work. The
# Node server privately proxies /api/v1 to the Signalam API origin.
NEXT_PUBLIC_BANTAI_API_URL=/api/v1
BANTAI_API_ORIGIN=https://api.example.invalid
NEXT_PUBLIC_SITE_URL=https://app.example.invalid

# Explicit local integration only. Production must leave this false and use
# either an HTTPS origin or the exact private Compose platform origin configured
# by docker-compose.yml.
BANTAI_ALLOW_HTTP_LOOPBACK=false
BANTAI_ALLOW_PRIVATE_PLATFORM_ORIGIN=false
