# Copy this template to backend\.env. The backend loads that file automatically.
# Use local absolute model paths. Never commit the real .env file.
BANTAI_MODEL_DIR=D:\path\to\checkpoint-15666
BANTAI_RF_MODEL_PATH=D:\path\to\bantai_rf_url_model_v4b_optimized.joblib
BANTAI_BACKEND_HOST=127.0.0.1
BANTAI_BACKEND_PORT=8000

# Shared account/dashboard service. When set, cloud review uses this gateway and
# no provider key is needed on the user's computer.
BANTAI_PLATFORM_API=https://bantai.example.com

# Optional Cloud AI Review. Keep the real key only in the backend environment.
BANTAI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BANTAI_LLM_TIMEOUT_SECONDS=12
BANTAI_LLM_MAX_RETRIES=0
BANTAI_LLM_THINKING_LEVEL=minimal
BANTAI_LLM_MAX_EMAIL_CHARS=7000
BANTAI_LLM_CACHE_TTL_SECONDS=600
