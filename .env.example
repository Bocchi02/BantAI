# Production server configuration used by docker-compose.yml.
# Copy to .env on the deployment host. Never commit the real file.
BANTAI_API_DOMAIN=api.example.invalid
BANTAI_WEB_DOMAIN=app.example.invalid
BANTAI_ROOT_DOMAIN=example.invalid
BANTAI_WEB_ORIGIN=https://app.example.invalid
BANTAI_EXTENSION_ORIGIN=chrome-extension://replace-with-released-extension-id
# Private network or address used by Caddy to reach the platform. Keep this
# required: forwarded client identity is trusted only from this source.
BANTAI_TRUSTED_PROXY_CIDRS=172.20.0.0/24

# Generate independent high-entropy values. The encryption key must be a
# URL-safe base64 encoding of exactly 32 bytes.
BANTAI_DB_RUNTIME_PASSWORD=replace-with-a-long-random-runtime-password
BANTAI_DB_MIGRATION_PASSWORD=replace-with-a-different-short-lived-migration-password
BANTAI_DB_ROOT_PASSWORD=replace-with-another-long-random-password
BANTAI_INTERNAL_API_KEY=replace-with-at-least-32-random-characters
BANTAI_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Backend-only Gemini access. Never place this key in extension or web assets.
GEMINI_API_KEY=replace-with-the-server-provider-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_URL_MODEL=gemini-3.5-flash-lite
BANTAI_LLM_TIMEOUT_SECONDS=12
BANTAI_LLM_MAX_RETRIES=0

# Operational limits. One detector worker is intentional so the large email
# model is loaded once per detector container.
BANTAI_DETECTOR_READINESS_TIMEOUT_SECONDS=5
BANTAI_DETECTOR_INFERENCE_TIMEOUT_SECONDS=45
BANTAI_DETECTION_RATE_LIMIT_PER_5_MINUTES=120

# Optional first administrator seed. Remove after the account exists.
BANTAI_ADMIN_EMAIL=
BANTAI_ADMIN_PASSWORD=
